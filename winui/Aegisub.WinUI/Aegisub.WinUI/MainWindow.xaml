<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Aegisub_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aegisub_WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Aegisub Translation Workspace">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="280" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header / command area -->
        <Border
            Grid.Row="0"
            Margin="16,16,16,0"
            Padding="14,10"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock
                        Text="Subtitle Translation Workspace"
                        FontSize="20"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="Test workspace · source + Czech target + transcript"
                        Opacity="0.65" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button Content="Otevřít projekt" />
                    <Button Content="Uložit" />
                    <Button Content="◀ Předchozí" />
                    <Button Content="Další ▶" />
                    <Button Content="Schválit" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main translation workspace -->
        <Grid
            Grid.Row="1"
            Margin="16,12,16,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Original source -->
            <Border
                Grid.Column="0"
                Padding="14"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="Originál"
                            FontSize="17"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Grid.Column="1"
                            Text="READ ONLY"
                            FontSize="11"
                            Opacity="0.55"
                            VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,4,0,10"
                        Text="#145 · 00:12:44.120 → 00:12:46.840"
                        FontFamily="Consolas"
                        FontSize="12"
                        Opacity="0.65" />

                    <TextBox
                        Grid.Row="2"
                        Text="We should be there before sunrise."
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        FontSize="19"
                        VerticalContentAlignment="Top" />
                </Grid>
            </Border>

            <!-- Czech target -->
            <Border
                Grid.Column="1"
                Padding="14"
                BorderBrush="#0078D4"
                BorderThickness="2"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="Čeština"
                            FontSize="17"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Grid.Column="1"
                            Text="EDITOVATELNÉ"
                            FontSize="11"
                            Opacity="0.65"
                            VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,4,0,10"
                        Text="#145 · připravený překlad"
                        FontSize="12"
                        Opacity="0.65" />

                    <TextBox
                        Grid.Row="2"
                        Text="Měli bychom tam být před východem slunce."
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        FontSize="19"
                        VerticalContentAlignment="Top" />

                    <StackPanel
                        Grid.Row="3"
                        Margin="0,10,0,0"
                        Orientation="Horizontal"
                        Spacing="12">
                        <TextBlock Text="CPL 43" Opacity="0.65" />
                        <TextBlock Text="CPS 15.8" Opacity="0.65" />
                        <TextBlock Text="Stav: upraveno" Opacity="0.65" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Transcript -->
            <Border
                Grid.Column="2"
                Padding="14"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="Přepis"
                            FontSize="17"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Grid.Column="1"
                            Text="AUTO FOLLOW"
                            FontSize="11"
                            Opacity="0.55"
                            VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,4,0,10"
                        Text="Kontext kolem aktuálního času"
                        FontSize="12"
                        Opacity="0.65" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <StackPanel>
                                <TextBlock
                                    Text="00:12:41.980"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Opacity="0.55" />
                                <TextBlock
                                    Text="If the road stays clear, we can still make it."
                                    TextWrapping="Wrap"
                                    Opacity="0.65" />
                            </StackPanel>

                            <Border
                                Padding="8"
                                BorderBrush="#0078D4"
                                BorderThickness="3,0,0,0">
                                <StackPanel>
                                    <TextBlock
                                        Text="00:12:44.120"
                                        FontFamily="Consolas"
                                        FontSize="11" />
                                    <TextBlock
                                        Text="We should be there before sunrise."
                                        TextWrapping="Wrap"
                                        FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <StackPanel>
                                <TextBlock
                                    Text="00:12:47.050"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Opacity="0.55" />
                                <TextBlock
                                    Text="Then we wait for the signal."
                                    TextWrapping="Wrap"
                                    Opacity="0.65" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Subtitle grid -->
        <Border
            Grid.Row="2"
            Margin="16,12,16,0"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="12,9" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="Titulky"
                        FontSize="16"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Grid.Column="1"
                        Text="5 z 842 · aktuální #145"
                        Opacity="0.6"
                        VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <Grid MinWidth="1050">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="115" />
                            <ColumnDefinition Width="115" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Grid.ColumnSpan="6" BorderBrush="Gray" BorderThickness="0,1,0,1" />
                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="10,8" Text="#" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="8" Text="Start" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Margin="8" Text="Konec" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Margin="8" Text="Originál" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="4" Margin="8" Text="Čeština" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="5" Margin="8" Text="Stav" FontWeight="SemiBold" />

                        <!-- Row 143 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="10,8" Text="143" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="8" Text="00:12:38.310" FontFamily="Consolas" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="8" Text="00:12:41.420" FontFamily="Consolas" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Margin="8" Text="We still have time." TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Grid.Column="4" Margin="8" Text="Pořád máme čas." TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Grid.Column="5" Margin="8" Text="Schváleno" />

                        <!-- Row 144 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="10,8" Text="144" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="8" Text="00:12:41.980" FontFamily="Consolas" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="8" Text="00:12:43.980" FontFamily="Consolas" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Margin="8" Text="If the road stays clear, we can still make it." TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Grid.Column="4" Margin="8" Text="Jestli zůstane cesta volná, pořád to stihneme." TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Grid.Column="5" Margin="8" Text="Schváleno" />

                        <!-- Current row 145 -->
                        <Border Grid.Row="3" Grid.ColumnSpan="6" BorderBrush="#0078D4" BorderThickness="4,1,0,1" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="10,8" Text="145" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="8" Text="00:12:44.120" FontFamily="Consolas" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Margin="8" Text="00:12:46.840" FontFamily="Consolas" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Margin="8" Text="We should be there before sunrise." TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="3" Grid.Column="4" Margin="8" Text="Měli bychom tam být před východem slunce." TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="3" Grid.Column="5" Margin="8" Text="Upraveno" FontWeight="SemiBold" />

                        <!-- Row 146 -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="10,8" Text="146" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="8" Text="00:12:47.050" FontFamily="Consolas" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Margin="8" Text="00:12:49.300" FontFamily="Consolas" />
                        <TextBlock Grid.Row="4" Grid.Column="3" Margin="8" Text="Then we wait for the signal." TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="4" Grid.Column="4" Margin="8" Text="Pak počkáme na signál." TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="4" Grid.Column="5" Margin="8" Text="Připraveno" />

                        <!-- Row 147 -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Margin="10,8" Text="147" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="8" Text="00:12:50.100" FontFamily="Consolas" />
                        <TextBlock Grid.Row="5" Grid.Column="2" Margin="8" Text="00:12:52.650" FontFamily="Consolas" />
                        <TextBlock Grid.Row="5" Grid.Column="3" Margin="8" Text="No mistakes this time." TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="5" Grid.Column="4" Margin="8" Text="Tentokrát bez chyb." TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="5" Grid.Column="5" Margin="8" Text="Připraveno" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status / keyboard hints -->
        <Grid
            Grid.Row="3"
            Margin="16,8,16,14"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="Testovací data · bez napojení na Aegisub core"
                Opacity="0.55" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="14">
                <TextBlock Text="Enter  →  uložit + další" Opacity="0.55" />
                <TextBlock Text="Ctrl+Enter  →  schválit + další" Opacity="0.55" />
                <TextBlock Text="Space  →  play/pause" Opacity="0.55" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
