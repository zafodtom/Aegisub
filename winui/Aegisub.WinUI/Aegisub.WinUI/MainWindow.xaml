<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Aegisub_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aegisub_WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Aegisub Translation Workspace">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="390" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Compact command bar -->
        <Border
            Grid.Row="0"
            Margin="14,12,14,0"
            Padding="14,10"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="1">
                    <TextBlock
                        Text="Překlad titulků"
                        FontSize="21"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="HeaderCurrentSubtitleText"
                        Text="Aktuální titulek #145 · 00:12:44.120 → 00:12:46.840 · délka 2.72 s"
                        FontSize="12"
                        Opacity="0.62" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button Content="Otevřít projekt" MinHeight="34" />
                    <Button Content="Uložit" MinHeight="34" Click="SaveButton_Click" />
                    <Button
                        x:Name="PreviousButton"
                        Content="◀ Předchozí"
                        MinHeight="34"
                        Click="PreviousButton_Click" />
                    <Button
                        x:Name="NextButton"
                        Content="Další ▶"
                        MinHeight="34"
                        Click="NextButton_Click" />
                    <Button Content="Schválit" MinHeight="34" Click="ApproveButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Translation workspace -->
        <Grid
            Grid.Row="1"
            Margin="14,12,14,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="0.8*" />
            </Grid.ColumnDefinitions>

            <!-- Original -->
            <Border
                Grid.Column="0"
                Padding="16"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Originál" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock
                            Grid.Column="1"
                            Text="POUZE PRO ČTENÍ"
                            FontSize="10"
                            Opacity="0.5"
                            VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        x:Name="OriginalTimingText"
                        Grid.Row="1"
                        Margin="0,5,0,12"
                        Text="#145 · 00:12:44.120 → 00:12:46.840"
                        FontFamily="Consolas"
                        FontSize="13"
                        Opacity="0.62" />

                    <TextBox
                        x:Name="OriginalTextBox"
                        Grid.Row="2"
                        Padding="14"
                        Text="We should be there before sunrise."
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        FontSize="24"
                        VerticalContentAlignment="Top" />
                </Grid>
            </Border>

            <!-- Czech target -->
            <Border
                x:Name="TargetPanelBorder"
                Grid.Column="1"
                Padding="16"
                BorderBrush="#0078D4"
                BorderThickness="2"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Čeština" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock
                            Grid.Column="1"
                            Text="EDITACE"
                            FontSize="10"
                            Opacity="0.58"
                            VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        x:Name="TargetInfoText"
                        Grid.Row="1"
                        Margin="0,5,0,12"
                        Text="#145 · Upraveno"
                        FontSize="13"
                        Opacity="0.62" />

                    <TextBox
                        x:Name="TargetTextBox"
                        Grid.Row="2"
                        Padding="14"
                        Text="Měli bychom tam být před východem slunce."
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        FontSize="24"
                        VerticalContentAlignment="Top"
                        TextChanged="TargetTextBox_TextChanged" />

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TargetCplText" Text="CPL 43" FontSize="12" Opacity="0.62" />
                        <TextBlock
                            x:Name="TargetCpsText"
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            Text="CPS 15.8"
                            FontSize="12"
                            Opacity="0.62" />
                        <TextBlock
                            x:Name="TargetStatusText"
                            Grid.Column="3"
                            Text="Stav: Upraveno"
                            FontSize="12"
                            Opacity="0.62" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Transcript -->
            <Border
                Grid.Column="2"
                Padding="16"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Přepis" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock
                            Grid.Column="1"
                            Text="AUTO FOLLOW"
                            FontSize="10"
                            Opacity="0.5"
                            VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,5,0,12"
                        Text="Kontext kolem aktuálního času"
                        FontSize="12"
                        Opacity="0.62" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <StackPanel x:Name="TranscriptPreviousBlock">
                                <TextBlock
                                    x:Name="TranscriptPreviousTimeText"
                                    Text="00:12:41.980"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Opacity="0.5" />
                                <TextBlock
                                    x:Name="TranscriptPreviousText"
                                    Margin="0,3,0,0"
                                    Text="If the road stays clear, we can still make it."
                                    TextWrapping="Wrap"
                                    FontSize="15"
                                    Opacity="0.62" />
                            </StackPanel>

                            <Border
                                Padding="10,8"
                                BorderBrush="#0078D4"
                                BorderThickness="4,0,0,0">
                                <StackPanel>
                                    <TextBlock
                                        x:Name="TranscriptCurrentTimeText"
                                        Text="00:12:44.120"
                                        FontFamily="Consolas"
                                        FontSize="11" />
                                    <TextBlock
                                        x:Name="TranscriptCurrentText"
                                        Margin="0,3,0,0"
                                        Text="We should be there before sunrise."
                                        TextWrapping="Wrap"
                                        FontSize="16"
                                        FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="TranscriptNextBlock">
                                <TextBlock
                                    x:Name="TranscriptNextTimeText"
                                    Text="00:12:47.050"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Opacity="0.5" />
                                <TextBlock
                                    x:Name="TranscriptNextText"
                                    Margin="0,3,0,0"
                                    Text="Then we wait for the signal."
                                    TextWrapping="Wrap"
                                    FontSize="15"
                                    Opacity="0.62" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Subtitle grid -->
        <Border
            Grid.Row="2"
            Margin="14,12,14,0"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="12,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="Titulky"
                        FontSize="17"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="TablePositionText"
                        Grid.Column="1"
                        Text="5 testovacích řádků · aktuální #145"
                        FontSize="12"
                        Opacity="0.58"
                        VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <Grid MinWidth="1180">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="118" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.ColumnSpan="6" BorderBrush="Gray" BorderThickness="0,1,0,1" />
                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="10,0" Text="#" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="8,0" Text="Start" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Margin="8,0" Text="Konec" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Margin="8,0" Text="Originál" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="4" Margin="8,0" Text="Čeština" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="5" Margin="8,0" Text="Stav" FontWeight="SemiBold" VerticalAlignment="Center" />

                        <!-- Row 143 -->
                        <Border
                            x:Name="Row143Border"
                            Grid.Row="1"
                            Grid.ColumnSpan="6"
                            Background="Transparent"
                            BorderBrush="#0078D4"
                            Tapped="SubtitleRow_Tapped" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="10,0" Text="143" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="8,0" Text="00:12:38.310" FontFamily="Consolas" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,0" Text="00:12:41.420" FontFamily="Consolas" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Margin="8,0" Text="We still have time." TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock x:Name="Row143TargetText" Grid.Row="1" Grid.Column="4" Margin="8,0" Text="Pořád máme čas." TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock x:Name="Row143StatusText" Grid.Row="1" Grid.Column="5" Margin="8,0" Text="Schváleno" VerticalAlignment="Center" IsHitTestVisible="False" />

                        <!-- Row 144 -->
                        <Border
                            x:Name="Row144Border"
                            Grid.Row="2"
                            Grid.ColumnSpan="6"
                            Background="Transparent"
                            BorderBrush="#0078D4"
                            Tapped="SubtitleRow_Tapped" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="10,0" Text="144" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="8,0" Text="00:12:41.980" FontFamily="Consolas" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="8,0" Text="00:12:43.980" FontFamily="Consolas" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Margin="8,0" Text="If the road stays clear, we can still make it." TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock x:Name="Row144TargetText" Grid.Row="2" Grid.Column="4" Margin="8,0" Text="Jestli zůstane cesta volná, pořád to stihneme." TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock x:Name="Row144StatusText" Grid.Row="2" Grid.Column="5" Margin="8,0" Text="Schváleno" VerticalAlignment="Center" IsHitTestVisible="False" />

                        <!-- Row 145 -->
                        <Border
                            x:Name="Row145Border"
                            Grid.Row="3"
                            Grid.ColumnSpan="6"
                            Background="Transparent"
                            BorderBrush="#0078D4"
                            BorderThickness="4,1,0,1"
                            Tapped="SubtitleRow_Tapped" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="10,0" Text="145" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="8,0" Text="00:12:44.120" FontFamily="Consolas" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Margin="8,0" Text="00:12:46.840" FontFamily="Consolas" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Margin="8,0" Text="We should be there before sunrise." TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock x:Name="Row145TargetText" Grid.Row="3" Grid.Column="4" Margin="8,0" Text="Měli bychom tam být před východem slunce." TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock x:Name="Row145StatusText" Grid.Row="3" Grid.Column="5" Margin="8,0" Text="Upraveno" VerticalAlignment="Center" IsHitTestVisible="False" />

                        <!-- Row 146 -->
                        <Border
                            x:Name="Row146Border"
                            Grid.Row="4"
                            Grid.ColumnSpan="6"
                            Background="Transparent"
                            BorderBrush="#0078D4"
                            Tapped="SubtitleRow_Tapped" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="10,0" Text="146" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="8,0" Text="00:12:47.050" FontFamily="Consolas" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Margin="8,0" Text="00:12:49.300" FontFamily="Consolas" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Grid.Row="4" Grid.Column="3" Margin="8,0" Text="Then we wait for the signal." TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock x:Name="Row146TargetText" Grid.Row="4" Grid.Column="4" Margin="8,0" Text="Pak počkáme na signál." TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock x:Name="Row146StatusText" Grid.Row="4" Grid.Column="5" Margin="8,0" Text="Připraveno" VerticalAlignment="Center" IsHitTestVisible="False" />

                        <!-- Row 147 -->
                        <Border
                            x:Name="Row147Border"
                            Grid.Row="5"
                            Grid.ColumnSpan="6"
                            Background="Transparent"
                            BorderBrush="#0078D4"
                            Tapped="SubtitleRow_Tapped" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Margin="10,0" Text="147" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="8,0" Text="00:12:50.100" FontFamily="Consolas" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Grid.Row="5" Grid.Column="2" Margin="8,0" Text="00:12:52.650" FontFamily="Consolas" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Grid.Row="5" Grid.Column="3" Margin="8,0" Text="No mistakes this time." TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock x:Name="Row147TargetText" Grid.Row="5" Grid.Column="4" Margin="8,0" Text="Tentokrát bez chyb." TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock x:Name="Row147StatusText" Grid.Row="5" Grid.Column="5" Margin="8,0" Text="Připraveno" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Grid
            Grid.Row="3"
            Margin="14,8,14,12"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="StatusBarText"
                Text="Testovací data · bez napojení na Aegisub core"
                FontSize="11"
                Opacity="0.5" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="16">
                <TextBlock Text="Enter → uložit + další" FontSize="11" Opacity="0.5" />
                <TextBlock Text="Ctrl+Enter → schválit + další" FontSize="11" Opacity="0.5" />
                <TextBlock Text="Space → play/pause" FontSize="11" Opacity="0.5" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
