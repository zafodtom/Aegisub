<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Aegisub_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aegisub_WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Aegisub Translation Workspace">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="390" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Compact command bar -->
        <Border
            Grid.Row="0"
            Margin="14,12,14,0"
            Padding="14,10"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="1">
                    <TextBlock
                        Text="Překlad titulků"
                        FontSize="21"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="HeaderCurrentSubtitleText"
                        Text="Aktuální titulek #145 · 00:12:44.120 → 00:12:46.840 · délka 2.72 s"
                        FontSize="12"
                        Opacity="0.62" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button
                        Content="Otevřít oba…"
                        MinHeight="34"
                        ToolTipService.ToolTip="Otevřít originál i češtinu · Ctrl+O"
                        Click="OpenBothButton_Click" />
                    <Button
                        Content="Originál…"
                        MinHeight="34"
                        ToolTipService.ToolTip="Otevřít pouze originální titulky"
                        Click="OpenSourceButton_Click" />
                    <Button
                        Content="Čeština…"
                        MinHeight="34"
                        ToolTipService.ToolTip="Otevřít pouze české titulky"
                        Click="OpenTargetButton_Click" />
                    <Button
                        Content="Uložit"
                        MinHeight="34"
                        ToolTipService.ToolTip="Uložit a zálohovat v LocalAppData · zálohy 30 dní, nejvýše 30 · Ctrl+S"
                        Click="SaveButton_Click" />
                    <Button
                        Content="Uložit jako…"
                        MinHeight="34"
                        ToolTipService.ToolTip="Uložit jako a zálohovat v LocalAppData · zálohy 30 dní, nejvýše 30 · Ctrl+Shift+S"
                        Click="SaveAsButton_Click" />
                    <Button
                        x:Name="PreviousButton"
                        Content="◀ Předchozí"
                        MinHeight="34"
                        Click="PreviousButton_Click" />
                    <Button
                        x:Name="NextButton"
                        Content="Další ▶"
                        MinHeight="34"
                        Click="NextButton_Click" />
                    <Button
                        x:Name="ApproveButton"
                        Content="Schválit"
                        MinHeight="34"
                        ToolTipService.ToolTip="Schválit a přejít dál · Ctrl+Enter"
                        Click="ApproveButton_Click" />
                    <Button
                        x:Name="NextReviewButton"
                        Content="Další ke kontrole"
                        MinHeight="34"
                        ToolTipService.ToolTip="F6 další neschválený · Shift+F6 předchozí neschválený"
                        Click="NextReviewButton_Click" />
                    <Button
                        x:Name="NextUntranslatedButton"
                        Content="Další nepřeložený"
                        MinHeight="34"
                        ToolTipService.ToolTip="F7 další nepřeložený · Shift+F7 předchozí nepřeložený"
                        Click="NextUntranslatedButton_Click" />
                    <Button
                        x:Name="NextProblemButton"
                        Content="Další problém"
                        MinHeight="34"
                        ToolTipService.ToolTip="F8 další problém · Shift+F8 předchozí problém"
                        Click="NextProblemButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Translation workspace -->
        <Grid
            Grid.Row="1"
            Margin="14,12,14,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="0.8*" />
            </Grid.ColumnDefinitions>

            <!-- Original -->
            <Border
                Grid.Column="0"
                Padding="16"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Originál" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="OriginalFileText"
                                Text="Soubor není načten"
                                FontSize="11"
                                Opacity="0.55"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Text="POUZE PRO ČTENÍ"
                            FontSize="10"
                            Opacity="0.5"
                            VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        x:Name="OriginalTimingText"
                        Grid.Row="1"
                        Margin="0,5,0,12"
                        Text="#145 · 00:12:44.120 → 00:12:46.840"
                        FontFamily="Consolas"
                        FontSize="13"
                        Opacity="0.62" />

                    <TextBox
                        x:Name="OriginalTextBox"
                        Grid.Row="2"
                        Padding="14"
                        Text="We should be there before sunrise."
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        FontSize="24"
                        VerticalContentAlignment="Top" />
                </Grid>
            </Border>

            <!-- Czech target -->
            <Border
                x:Name="TargetPanelBorder"
                Grid.Column="1"
                Padding="16"
                BorderBrush="#0078D4"
                BorderThickness="2"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Čeština" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="TargetFileText"
                                Text="Soubor není načten"
                                FontSize="11"
                                Opacity="0.55"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Text="EDITACE"
                            FontSize="10"
                            Opacity="0.58"
                            VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        x:Name="TargetInfoText"
                        Grid.Row="1"
                        Margin="0,5,0,12"
                        Text="#145 · Upraveno"
                        FontSize="13"
                        Opacity="0.62" />

                    <TextBox
                        x:Name="TargetTextBox"
                        Grid.Row="2"
                        Padding="14"
                        Text="Měli bychom tam být před východem slunce."
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        FontSize="24"
                        VerticalContentAlignment="Top"
                        Loaded="TargetTextBox_WorkflowLoaded"
                        TextChanged="TargetTextBox_TextChanged" />

                    <Grid Grid.Row="3" Margin="0,10,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="TargetCplText"
                            Text="CPL 43"
                            FontSize="12"
                            Opacity="0.62"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="TargetCpsText"
                            Grid.Column="1"
                            Text="CPS 15.8"
                            FontSize="12"
                            Opacity="0.62"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="3"
                            Content="Převzít originál"
                            Padding="8,2"
                            MinHeight="26"
                            FontSize="11"
                            ToolTipService.ToolTip="Nahradit český text originálem · změnu lze vrátit přes Ctrl+Z"
                            Click="CopyOriginalButton_Click" />
                        <Button
                            Grid.Column="4"
                            Content="Zalomit řádek"
                            Padding="8,2"
                            MinHeight="26"
                            FontSize="11"
                            Click="InsertLineBreakButton_Click" />
                        <TextBlock
                            x:Name="TargetStatusText"
                            Grid.Column="5"
                            Text="Stav: Upraveno"
                            FontSize="12"
                            Opacity="0.62"
                            VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Transcript -->
            <Border
                Grid.Column="2"
                Padding="16"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Přepis" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock
                            Grid.Column="1"
                            Text="AUTO FOLLOW"
                            FontSize="10"
                            Opacity="0.5"
                            VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,5,0,12"
                        Text="Kontext kolem aktuálního času"
                        FontSize="12"
                        Opacity="0.62" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <StackPanel x:Name="TranscriptPreviousBlock">
                                <TextBlock
                                    x:Name="TranscriptPreviousTimeText"
                                    Text="00:12:41.980"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Opacity="0.5" />
                                <TextBlock
                                    x:Name="TranscriptPreviousText"
                                    Margin="0,3,0,0"
                                    Text="If the road stays clear, we can still make it."
                                    TextWrapping="Wrap"
                                    FontSize="15"
                                    Opacity="0.62" />
                            </StackPanel>

                            <Border
                                Padding="10,8"
                                BorderBrush="#0078D4"
                                BorderThickness="4,0,0,0">
                                <StackPanel>
                                    <TextBlock
                                        x:Name="TranscriptCurrentTimeText"
                                        Text="00:12:44.120"
                                        FontFamily="Consolas"
                                        FontSize="11" />
                                    <TextBlock
                                        x:Name="TranscriptCurrentText"
                                        Margin="0,3,0,0"
                                        Text="We should be there before sunrise."
                                        TextWrapping="Wrap"
                                        FontSize="16"
                                        FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="TranscriptNextBlock">
                                <TextBlock
                                    x:Name="TranscriptNextTimeText"
                                    Text="00:12:47.050"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Opacity="0.5" />
                                <TextBlock
                                    x:Name="TranscriptNextText"
                                    Margin="0,3,0,0"
                                    Text="Then we wait for the signal."
                                    TextWrapping="Wrap"
                                    FontSize="15"
                                    Opacity="0.62" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Subtitle grid. Rows are created dynamically from loaded subtitle data. -->
        <Border
            Grid.Row="2"
            Margin="14,12,14,0"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="12,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="Titulky"
                        FontSize="17"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="18,0"
                        Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <TextBox
                            x:Name="SearchTextBox"
                            Width="270"
                            MinHeight="30"
                            PlaceholderText="Hledat v originálu i češtině…"
                            ToolTipService.ToolTip="Ctrl+F hledat · Enter další · Shift+Enter předchozí"
                            TextChanged="SearchTextBox_TextChanged"
                            KeyDown="SearchTextBox_KeyDown" />
                        <Button
                            x:Name="SearchPreviousButton"
                            Content="↑"
                            MinWidth="32"
                            MinHeight="30"
                            ToolTipService.ToolTip="Předchozí výskyt · Shift+F3"
                            Click="SearchPreviousButton_Click" />
                        <Button
                            x:Name="SearchNextButton"
                            Content="↓"
                            MinWidth="32"
                            MinHeight="30"
                            ToolTipService.ToolTip="Další výskyt · F3"
                            Click="SearchNextButton_Click" />
                        <TextBlock
                            x:Name="SearchResultText"
                            MinWidth="55"
                            FontSize="11"
                            Opacity="0.58"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        x:Name="TablePositionText"
                        Grid.Column="2"
                        Text="Načítání titulků…"
                        FontSize="12"
                        Opacity="0.58"
                        VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <Grid MinWidth="1180">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="118" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Grid
            Grid.Row="3"
            Margin="14,8,14,12"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="StatusBarText"
                Text="Připraveno"
                FontSize="11"
                Opacity="0.5" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="14">
                <TextBlock Text="Shift+Enter → nový řádek" FontSize="11" Opacity="0.5" />
                <TextBlock Text="Enter → potvrdit + další" FontSize="11" Opacity="0.5" />
                <TextBlock Text="Ctrl+Enter → schválit + další" FontSize="11" Opacity="0.5" />
                <TextBlock Text="Ctrl+Z/Y → zpět/znovu" FontSize="11" Opacity="0.5" />
                <TextBlock Text="Ctrl+O/S → otevřít/uložit" FontSize="11" Opacity="0.5" />
                <TextBlock Text="Ctrl+Shift+S → uložit jako" FontSize="11" Opacity="0.5" />
                <TextBlock Text="F7 → nepřeložený" FontSize="11" Opacity="0.5" />
                <TextBlock Text="F6 → ke kontrole" FontSize="11" Opacity="0.5" />
                <TextBlock Text="Ctrl+F / F3 → hledat" FontSize="11" Opacity="0.5" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
