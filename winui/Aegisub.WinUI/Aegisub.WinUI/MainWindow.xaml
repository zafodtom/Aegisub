<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Aegisub_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aegisub_WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Aegisub">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded" AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="7,3" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="FontSize" Value="11" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Classic desktop menu; working context lives near the subtitle list. -->
        <Border Grid.Row="0" Margin="10,6,10,0" Padding="2,0" BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
            <MenuBar>
                <MenuBarItem Title="Soubor">
                    <MenuFlyoutItem Text="Nový projekt    Ctrl+N" Click="NewProjectMenuItem_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Otevřít video…" Click="OpenVideoButton_Click" />
                    <MenuFlyoutItem Text="Otevřít audio…" Click="OpenAudioButton_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Otevřít originál + překlad…" Click="OpenBothButton_Click" />
                    <MenuFlyoutItem Text="Otevřít originál…" Click="OpenSourceButton_Click" />
                    <MenuFlyoutItem Text="Otevřít překlad…" Click="OpenTargetButton_Click" />
                    <MenuFlyoutItem x:Name="RecentProjectMenuItem" Text="Otevřít naposledy použité" IsEnabled="False" Click="OpenRecentProjectButton_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Zavřít video" Click="CloseVideoMenuItem_Click" />
                    <MenuFlyoutItem Text="Zavřít originál" Click="CloseSourceMenuItem_Click" />
                    <MenuFlyoutItem Text="Zavřít překlad" Click="CloseTargetMenuItem_Click" />
                    <MenuFlyoutItem Text="Přehodit originál ↔ překlad" Click="SwapSourceTargetMenuItem_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Uložit" Click="SaveButton_Click" />
                    <MenuFlyoutItem Text="Uložit jako…" Click="SaveAsButton_Click" />
                    <MenuFlyoutItem x:Name="RestoreBackupButton" Text="Obnovit poslední zálohu…" IsEnabled="False" Click="RestoreBackupButton_Click" />
                </MenuBarItem>

                <MenuBarItem Title="Úpravy">
                    <MenuFlyoutItem Text="Najít…    Ctrl+F" Click="SearchMenuItem_Click" />
                    <MenuFlyoutItem Text="Nahradit…    Ctrl+R" Click="ReplaceMenuItem_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Převzít originál" Click="CopyOriginalButton_Click" />
                    <MenuFlyoutItem Text="Zalomit řádek" Click="InsertLineBreakButton_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Vybrat vše v překladu" Click="TargetSelectAllMenuItem_Click" />
                </MenuBarItem>

                <MenuBarItem Title="Titulky">
                    <MenuFlyoutItem Text="Přidat titulek nad" Click="InsertSubtitleAboveButton_Click" />
                    <MenuFlyoutItem Text="Přidat titulek pod" Click="InsertSubtitleBelowButton_Click" />
                    <MenuFlyoutItem Text="Přidat titulek na pozici videa" Click="InsertSubtitleAtVideoButton_Click" />
                    <MenuFlyoutItem Text="Zdvojit řádek" Click="DuplicateSubtitleButton_Click" />
                    <MenuFlyoutItem Text="Smazat titulek" Click="DeleteSubtitleButton_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Rozdělit v kurzoru" Click="SplitSubtitleButton_Click" />
                    <MenuFlyoutItem Text="Sloučit vybrané titulky" Click="MergeSelectedSubtitlesButton_Click" />
                </MenuBarItem>

                <MenuBarItem Title="Časování">
                    <MenuFlyoutItem Text="Posunout všechny titulky…" Click="ShiftAllSubtitlesMenuItem_Click" />
                    <MenuFlyoutItem Text="Vložit 1 ms mezeru mezi navazující titulky" Click="InsertSubtitleGapMenuItem_Click" />
                </MenuBarItem>

                <MenuBarItem Title="Zobrazení">
                    <MenuFlyoutItem x:Name="ToggleOriginalPanelMenuItem" Text="Skrýt originál" Click="ToggleOriginalPanelMenuItem_Click" />
                </MenuBarItem>
            </MenuBar>
        </Border>

        <!-- Aegisub-like media area: small video, large local waveform, optional context. -->
        <Grid Grid.Row="1" Margin="10,8,10,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="8" BorderBrush="Gray" BorderThickness="1" CornerRadius="6">
                <Grid RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Video" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="VideoFileText" Grid.Column="1" Text="" FontSize="10" Opacity="0.5" TextTrimming="CharacterEllipsis" MaxWidth="210" />
                    </Grid>
                    <Border Grid.Row="1" Background="Black" CornerRadius="3">
                        <MediaPlayerElement x:Name="VideoPlayer" AreTransportControlsEnabled="False" AutoPlay="False" Stretch="Uniform" />
                    </Border>
                    <Grid Grid.Row="2" Margin="0,2,0,0" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="VideoPlayPauseButton" Grid.Column="0" Content="▶" Width="44" MinWidth="44" Padding="0,2" FontSize="14" Click="VideoPlayPauseButton_Click" ToolTipService.ToolTip="Přehrát / pozastavit" />
                        <Button x:Name="VideoPlaySelectedButton" Grid.Column="1" Content="Přehrát titulek" Width="118" MinWidth="118" Padding="8,2" Click="VideoPlaySelectedButton_Click" ToolTipService.ToolTip="Přehrát pouze časový úsek vybraného titulku" />
                        <TextBlock x:Name="VideoPositionText" Grid.Column="2" Text="00:00:00.000" FontFamily="Consolas" FontSize="10" Opacity="0.58" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="8" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="6">
                <Grid RowSpacing="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Zvuková vlna" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="WaveformFileText" Text="" FontSize="9.5"
                                       Opacity="0.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Zoom" FontSize="9.5" Opacity="0.55" VerticalAlignment="Center" />
                            <Button Content="H−" Width="30" MinWidth="30" Height="20" MinHeight="20" Padding="3,0"
                                    Click="WaveformHorizontalZoomOutButton_Click" ToolTipService.ToolTip="Horizontálně zmenšit · zobrazit více času" />
                            <Button Content="H+" Width="30" MinWidth="30" Height="20" MinHeight="20" Padding="3,0"
                                    Click="WaveformHorizontalZoomInButton_Click" ToolTipService.ToolTip="Horizontálně zvětšit · zobrazit méně času" />
                            <Button Content="V−" Width="30" MinWidth="30" Height="20" MinHeight="20" Padding="3,0"
                                    Click="WaveformVerticalZoomOutButton_Click" ToolTipService.ToolTip="Snížit výšku zvukové vlny" />
                            <Button Content="V+" Width="30" MinWidth="30" Height="20" MinHeight="20" Padding="3,0"
                                    Click="WaveformVerticalZoomInButton_Click" ToolTipService.ToolTip="Zvýšit výšku zvukové vlny" />
                        </StackPanel>
                    </Grid>
                    <Canvas x:Name="WholeTimelineCanvas" Grid.Row="1" Background="Transparent"
                            SizeChanged="WholeTimelineCanvas_SizeChanged"
                            ToolTipService.ToolTip="Přehled celé délky videa. Zvýrazněný úsek odpovídá detailu zobrazenému ve waveformu." />
                    <Slider x:Name="TimelineSlider" Grid.Row="2" Minimum="0" Maximum="1" Value="0"
                            Margin="0,-2,0,-2" SmallChange="0.1" LargeChange="5"
                            IsThumbToolTipEnabled="False"
                            ValueChanged="TimelineSlider_ValueChanged"
                            ToolTipService.ToolTip="Aktuální pozice videa v celé délce souboru" />
                    <Border Grid.Row="3" Background="#08000000" CornerRadius="3">
                        <Canvas x:Name="WaveformCanvas" Background="Transparent"
                                SizeChanged="WaveformCanvas_SizeChanged"
                                PointerPressed="WaveformCanvas_PointerPressed"
                                PointerMoved="WaveformCanvas_PointerMoved"
                                PointerReleased="WaveformCanvas_PointerReleased" />
                    </Border>
                    <Grid Grid.Row="4">
                        <TextBlock x:Name="WaveformRangeText" Text=""
                                   FontFamily="Consolas" FontSize="10" Opacity="0.55"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Button x:Name="WaveformPlaySelectedButton" Content="▶ Titulek"
                                Width="190" MinWidth="190" MinHeight="26" Height="26" Padding="10,0"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Click="VideoPlaySelectedButton_Click"
                                ToolTipService.ToolTip="Přehrát / pozastavit aktuální titulek" />
                        <Border Width="22" Height="22" CornerRadius="11" BorderBrush="Gray" BorderThickness="1"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                ToolTipService.ToolTip="Levé kliknutí = začátek. Dvojklik = automaticky vybrat souvislý aktivní úsek zvuku kolem kurzoru. Levé tažení = vytvořit nový rozsah od–do. Pravé kliknutí/tažení = konec. Prostřední klik = přehrát od tohoto místa. Prostřední tlačítko + tažení = posunout celý titulek. Shift + tažení = posunout pohled waveformu. H± mění časový zoom, V± výšku vlny.">
                            <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="TranscriptPanel" Grid.Column="2" Padding="8" BorderBrush="Gray" BorderThickness="1" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Kontext / transcript" FontSize="12" FontWeight="SemiBold" />

                        <StackPanel x:Name="TranscriptPrev3Block">
                            <TextBlock x:Name="TranscriptPrev3TimeText" FontFamily="Consolas" FontSize="9" Opacity="0.4" />
                            <TextBlock x:Name="TranscriptPrev3Text" TextWrapping="Wrap" FontSize="10.5" Opacity="0.48" />
                        </StackPanel>
                        <StackPanel x:Name="TranscriptPrev2Block">
                            <TextBlock x:Name="TranscriptPrev2TimeText" FontFamily="Consolas" FontSize="9" Opacity="0.42" />
                            <TextBlock x:Name="TranscriptPrev2Text" TextWrapping="Wrap" FontSize="10.5" Opacity="0.52" />
                        </StackPanel>
                        <StackPanel x:Name="TranscriptPreviousBlock">
                            <TextBlock x:Name="TranscriptPreviousTimeText" FontFamily="Consolas" FontSize="9.5" Opacity="0.45" />
                            <TextBlock x:Name="TranscriptPreviousText" TextWrapping="Wrap" FontSize="10.5" Opacity="0.58" />
                        </StackPanel>

                        <Border Padding="7,5" BorderBrush="#0078D4" BorderThickness="3,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="TranscriptCurrentTimeText" FontFamily="Consolas" FontSize="9.5" />
                                <TextBlock x:Name="TranscriptCurrentText" TextWrapping="Wrap" FontSize="11.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="TranscriptNextBlock">
                            <TextBlock x:Name="TranscriptNextTimeText" FontFamily="Consolas" FontSize="9.5" Opacity="0.45" />
                            <TextBlock x:Name="TranscriptNextText" TextWrapping="Wrap" FontSize="10.5" Opacity="0.58" />
                        </StackPanel>
                        <StackPanel x:Name="TranscriptNext2Block">
                            <TextBlock x:Name="TranscriptNext2TimeText" FontFamily="Consolas" FontSize="9" Opacity="0.42" />
                            <TextBlock x:Name="TranscriptNext2Text" TextWrapping="Wrap" FontSize="10.5" Opacity="0.52" />
                        </StackPanel>
                        <StackPanel x:Name="TranscriptNext3Block">
                            <TextBlock x:Name="TranscriptNext3TimeText" FontFamily="Consolas" FontSize="9" Opacity="0.4" />
                            <TextBlock x:Name="TranscriptNext3Text" TextWrapping="Wrap" FontSize="10.5" Opacity="0.48" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Text correction + subtitle grid. -->
        <Border Grid.Row="2" Margin="10,8,10,0" BorderBrush="Gray" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="220" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.0*" />
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="OriginalPanelBorder" Grid.Column="0" Padding="10" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Originál" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock x:Name="OriginalFileText" Text="" FontSize="9.5" Opacity="0.5" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="?" FontSize="10" Opacity="0.42"
                                           ToolTipService.ToolTip="Originální titulky slouží jako referenční text a časování pro překlad." />
                            </Grid>
                            <TextBlock x:Name="OriginalTimingText" Grid.Row="1" Margin="0,4,0,6" FontFamily="Consolas" FontSize="11" Opacity="0.58" />
                            <TextBox x:Name="OriginalTextBox" Grid.Row="2" Padding="8" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" FontSize="16" SelectionChanged="SubtitleEditor_SelectionChanged" />
                        </Grid>
                    </Border>

                    <Border x:Name="TargetPanelBorder" Grid.Column="1" Padding="10" BorderBrush="#0078D4" BorderThickness="2" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Překlad" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TargetFileText" Text="" FontSize="9.5" Opacity="0.5" />
                                </StackPanel>
                                <TextBlock x:Name="TargetInfoText" Grid.Column="1" FontSize="9.5" Opacity="0.5" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <Button Content="＋↑" Width="30" MinWidth="30" Height="26" MinHeight="26" Padding="0"
                                            Click="InsertSubtitleAboveButton_Click"
                                            ToolTipService.ToolTip="Přidat nový titulek nad aktuální řádek · délka 2 s" />
                                    <Button Content="＋↓" Width="30" MinWidth="30" Height="26" MinHeight="26" Padding="0"
                                            Click="InsertSubtitleBelowButton_Click"
                                            ToolTipService.ToolTip="Přidat nový titulek pod aktuální řádek · délka 2 s" />
                                    <Button Content="✕" Width="30" MinWidth="30" Height="26" MinHeight="26" Padding="0"
                                            Click="DeleteSubtitleButton_Click"
                                            ToolTipService.ToolTip="Smazat aktuální titulek · Ctrl+Delete" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,4,0,6" ColumnSpacing="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Start" FontSize="9.5" VerticalAlignment="Center" Opacity="0.6" />
                                <TextBox x:Name="StartTimeBox" Grid.Column="1" Height="22" MinHeight="22" FontFamily="Consolas" FontSize="10.5"
                                         Padding="4,0" TextAlignment="Center" VerticalContentAlignment="Center" KeyDown="TimingTextBox_KeyDown" />
                                <TextBlock Grid.Column="2" Text="Konec" FontSize="9.5" VerticalAlignment="Center" Opacity="0.6" />
                                <TextBox x:Name="EndTimeBox" Grid.Column="3" Height="22" MinHeight="22" FontFamily="Consolas" FontSize="10.5"
                                         Padding="4,0" TextAlignment="Center" VerticalContentAlignment="Center" KeyDown="TimingTextBox_KeyDown" />
                                <Button Grid.Column="4" Content="−100" Height="22" MinHeight="22" Padding="5,0" Click="TimingShiftBackButton_Click" />
                                <Button Grid.Column="5" Content="+100" Height="22" MinHeight="22" Padding="5,0" Click="TimingShiftForwardButton_Click" />
                                <Button Grid.Column="6" Content="Použít" Height="22" MinHeight="22" Padding="7,0" Click="TimingApplyButton_Click" />
                                <TextBlock x:Name="TimingDurationText" Grid.Column="7" FontSize="10" Opacity="0.55" VerticalAlignment="Center" />
                            </Grid>

                            <TextBox x:Name="TargetTextBox" Grid.Row="2" Padding="8" AcceptsReturn="True" TextWrapping="Wrap" FontSize="16"
                                     Language="cs-CZ" IsSpellCheckEnabled="True" IsTextPredictionEnabled="False"
                                     SelectionChanged="SubtitleEditor_SelectionChanged"
                                     Loaded="TargetTextBox_WorkflowLoaded" TextChanged="TargetTextBox_TextChanged">
                                <TextBox.ContextFlyout>
                                    <TextCommandBarFlyout>
                                        <TextCommandBarFlyout.SecondaryCommands>
                                            <AppBarButton Label="Rozdělit v kurzoru" Click="SplitSubtitleButton_Click" />
                                        </TextCommandBarFlyout.SecondaryCommands>
                                    </TextCommandBarFlyout>
                                </TextBox.ContextFlyout>
                            </TextBox>

                            <Grid Grid.Row="3" Margin="0,5,0,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TargetCplText" Text="CPL 0" FontSize="10" Opacity="0.5" />
                                <TextBlock x:Name="TargetCpsText" Grid.Column="1" Text="CPS 0" FontSize="10" Opacity="0.5" />
                                <TextBlock x:Name="TargetLengthText" Grid.Column="2" Text="Znaky 0" FontSize="10" Opacity="0.5" />
                                <TextBlock x:Name="TargetProblemText" Grid.Column="3" Margin="8,0" FontSize="9.5"
                                           Foreground="#D13438" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                <StackPanel Grid.Column="4" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6">
                                    <Button Content="Převzít originál" Padding="6,2" FontSize="11" Click="CopyOriginalButton_Click" />
                                    <Button Content="Zalomit řádek" Padding="6,2" FontSize="11" Click="InsertLineBreakButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Padding="8" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                        <Grid RowSpacing="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Překladatelský manuál" FontSize="12" FontWeight="SemiBold"
                                       ToolTipService.ToolTip="Výrazy nalezené v aktuálním originálu jsou řazené nahoru. Ostatní výrazy jsou abecedně. Pořadí se během editace řádku nemění." />

                            <Grid Grid.Row="1" ColumnSpacing="5" Margin="0,-1,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Originál" FontSize="10" FontWeight="SemiBold" Opacity="0.65" />
                                <TextBlock Grid.Column="1" Text="Překlad" FontSize="10" FontWeight="SemiBold" Opacity="0.65" />
                            </Grid>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <Grid x:Name="GlossaryGridHost" ColumnSpacing="5" RowSpacing="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ScrollViewer>

                            <Grid Grid.Row="3" ColumnSpacing="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="GlossaryFileText" Text="bez souboru" FontSize="9" Opacity="0.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Content="+ řádek" Padding="6,2" FontSize="11" Click="GlossaryAddButton_Click" />
                                <Button Grid.Column="2" Content="Import…" Padding="6,2" FontSize="11" Click="GlossaryImportButton_Click" />
                                <Button Grid.Column="3" Content="Export…" Padding="6,2" FontSize="11" Click="GlossaryExportButton_Click" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Padding="10,2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Titulky" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="Klik = jeden titulek · Ctrl+klik = přidat/odebrat · Shift+klik nebo tažení myší = souvislý výběr. ↑/↓ mění aktuální titulek." />
                        <TextBlock x:Name="TablePositionText" Grid.Column="1" FontSize="10" Opacity="0.58" VerticalAlignment="Center" />
                        <TextBlock x:Name="SubtitleSelectionText" Grid.Column="3" Text="0 titulků" FontSize="10" Opacity="0.55" VerticalAlignment="Center" />
                        <Button Grid.Column="4" Content="Sloučit vybrané" Padding="7,2" FontSize="11" Click="MergeSelectedSubtitlesButton_Click"
                                ToolTipService.ToolTip="Sloučit souvisle vybrané titulky; Ctrl+klik, Shift+klik nebo tažení myší" />
                    </Grid>

                    <ScrollViewer x:Name="SubtitleHorizontalScrollViewer" Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid MinWidth="1000">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="0,1,0,1">
                                <Grid x:Name="SubtitleColumnHeader">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55" /><ColumnDefinition Width="125" /><ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="105" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#" Margin="10,0,4,0" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Start" Margin="8,0,4,0" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Konec" Margin="8,0,4,0" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="Originál" Margin="8,0,4,0" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="Překlad" Margin="8,0,4,0" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="Stav" Margin="8,0,4,0" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ScrollViewer x:Name="SubtitleScrollViewer" Grid.Row="1"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <Grid x:Name="SubtitleGridHost">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55" /><ColumnDefinition Width="125" /><ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="105" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="SearchBar" Grid.Row="3" Margin="10,5,10,0" Padding="7,5"
                BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Najít" VerticalAlignment="Center" />
                <TextBox x:Name="SearchTextBox" Grid.Column="1" Height="26" MinHeight="26" Padding="5,0"
                         VerticalContentAlignment="Center"
                         TextChanged="AdvancedSearchTextBox_TextChanged"
                         KeyDown="AdvancedSearchTextBox_KeyDown" />
                <Button x:Name="SearchPreviousButton" Grid.Column="2" Content="↑" Width="30" MinWidth="30"
                        Click="AdvancedSearchPreviousButton_Click" ToolTipService.ToolTip="Předchozí výskyt" />
                <Button x:Name="SearchNextButton" Grid.Column="3" Content="↓" Width="30" MinWidth="30"
                        Click="AdvancedSearchNextButton_Click" ToolTipService.ToolTip="Další výskyt" />

                <ComboBox x:Name="SearchScopeComboBox" Grid.Column="4" Width="105" SelectedIndex="0"
                          SelectionChanged="SearchScopeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Překlad" />
                    <ComboBoxItem Content="Originál" />
                    <ComboBoxItem Content="Obojí" />
                </ComboBox>

                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <CheckBox x:Name="SearchCaseCheckBox" Content="Aa"
                              Checked="SearchOptions_Changed" Unchecked="SearchOptions_Changed"
                              ToolTipService.ToolTip="Rozlišovat velikost písmen" />
                    <CheckBox x:Name="SearchWholeWordCheckBox" Content="Slovo"
                              Checked="SearchOptions_Changed" Unchecked="SearchOptions_Changed"
                              ToolTipService.ToolTip="Pouze celá slova" />
                </StackPanel>

                <StackPanel x:Name="ReplaceSearchPanel" Grid.Column="6" Orientation="Horizontal" Spacing="5"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Nahradit" VerticalAlignment="Center" />
                    <TextBox x:Name="ReplaceTextBox" Width="180" Height="26" MinHeight="26" Padding="5,0"
                             VerticalContentAlignment="Center" />
                    <Button Content="Nahradit" Click="ReplaceCurrentButton_Click"
                            ToolTipService.ToolTip="Nahradit aktuální nalezený výskyt" />
                    <Button Content="Nahradit vše" Click="AdvancedReplaceAllButton_Click" />
                    <Button Content="Najít a odstranit" Click="FindAndRemoveButton_Click"
                            ToolTipService.ToolTip="Odstranit nalezený text; pokud titulek zůstane prázdný, odstranit i celý řádek" />
                    <Button Content="Odstranit prázdné" Click="RemoveEmptySubtitlesButton_Click"
                            ToolTipService.ToolTip="Odstranit všechny prázdné titulky" />
                </StackPanel>

                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="SearchResultText" VerticalAlignment="Center" Opacity="0.58" />
                    <Button Content="✕" Width="30" MinWidth="30" Click="CloseSearchBarButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="10,5,10,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusBarText" Text="Připraveno" FontSize="10" Opacity="0.5" />
            <TextBlock Grid.Column="1" Text="?" FontSize="10" Opacity="0.42"
                       ToolTipService.ToolTip="↑/↓ předchozí/další titulek · Ctrl+S uložit · Enter další · Shift+Enter nový řádek" />
        </Grid>

        <!-- Existing advanced functionality stays instantiated for now, but it is no longer the main UI. -->
        <StackPanel Visibility="Collapsed">
            <TextBlock x:Name="HeaderCurrentSubtitleText" />
            <Button x:Name="PreviousButton" />
            <Button x:Name="NextButton" />
            <Button x:Name="ApproveButton" />
            <Button x:Name="NextReviewButton" />
            <Button x:Name="NextUntranslatedButton" />
            <Button x:Name="NextProblemButton" />
            <TextBlock x:Name="TargetStatusText" />
            <TextBlock x:Name="PairingQualityText" />

            <Button Click="MergeLinesButton_Click" />
            <Button Click="SplitSubtitleButton_Click" />
            <Button Click="JoinNextSubtitleButton_Click" />
            <Button Click="InsertSubtitleButton_Click" />
            <Button Click="DeleteSubtitleButton_Click" />
            <Button Click="PairPreviousButton_Click" />
            <Button Click="PairNextButton_Click" />
            <Button Click="PairIgnoreButton_Click" />
            <Button Click="TimingStartBackButton_Click" />
            <Button Click="TimingStartForwardButton_Click" />
            <Button Click="TimingEndBackButton_Click" />
            <Button Click="TimingEndForwardButton_Click" />

            <NumberBox x:Name="QaCplBox" />
            <NumberBox x:Name="QaCpsBox" />
            <NumberBox x:Name="QaMinDurationBox" />
            <NumberBox x:Name="QaMaxLinesBox" />
            <NumberBox x:Name="QaLengthMinBox" />
            <NumberBox x:Name="QaLengthMaxBox" />
            <NumberBox x:Name="EditorFontSizeBox" />
            <CheckBox x:Name="CzechQuotesCheckBox" />
            <CheckBox x:Name="AutosaveCheckBox" />
            <ComboBox x:Name="UiLanguageComboBox"><ComboBoxItem Content="Čeština" Tag="cs-CZ" /><ComboBoxItem Content="English" Tag="en-US" /></ComboBox>
            <ComboBox x:Name="ThemeComboBox"><ComboBoxItem Content="System" Tag="system" /><ComboBoxItem Content="Light" Tag="light" /><ComboBoxItem Content="Dark" Tag="dark" /></ComboBox>
            <TextBox x:Name="DefaultDirectoryTextBox" />
            <Button x:Name="ApplyWorkspaceSettingsButton" />
            <ComboBox x:Name="RecentProjectsComboBox" />
            <Button x:Name="OpenSelectedRecentProjectButton" />
            <TextBlock x:Name="RecoveryHistoryText" />
            <ComboBox x:Name="RecoveryVersionsComboBox" />
            <Button x:Name="RestoreSelectedRecoveryButton" />

            <ComboBox x:Name="FilterComboBox">
                <ComboBoxItem x:Name="FilterAllItem" Content="Všechny" />
                <ComboBoxItem x:Name="FilterUntranslatedItem" Content="Nepřeložené" />
                <ComboBoxItem x:Name="FilterModifiedItem" Content="Upravené" />
                <ComboBoxItem x:Name="FilterProblemsItem" Content="Problémy" />
                <ComboBoxItem x:Name="FilterReadyItem" Content="Připravené" />
                <ComboBoxItem x:Name="FilterApprovedItem" Content="Schválené" />
            </ComboBox>
            <Button x:Name="UndoBulkButton" />
            <ProgressBar x:Name="OverviewProgressBar" />
            <TextBlock x:Name="OverviewFilesText" />
            <TextBlock x:Name="OverviewTranslatedText" />
            <TextBlock x:Name="OverviewModifiedText" />
            <TextBlock x:Name="OverviewReadyText" />
            <TextBlock x:Name="OverviewApprovedText" />
            <TextBlock x:Name="OverviewProblemsText" />
            <TextBlock x:Name="OverviewVisibleText" />
            <TextBlock x:Name="OverviewEstimateText" />
        </StackPanel>
    </Grid>
</Window>
